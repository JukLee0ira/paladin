go 1.26.0

toolchain go1.26.4

// this just contains what's needed for the base-builder in docker
// By running this first, we get a big head start on the pre-reqs install
// for the build in a cached container
use (
	./config
	./common/go
	./sdk/go
	./toolkit/go
)

replace github.com/aidarkhanov/nanoid => ./third_party/aidarkhanov-nanoid

replace github.com/tyler-smith/go-bip39 => github.com/cosmos/go-bip39 v1.0.0
